/*--------------------------------*- C++ -*----------------------------------*\
  box_refined: 8 x 6 x 4 hexes on 1 x 0.75 x 0.5 (h = 0.125), cyclic on every
  axis, then refineMesh splits a box region (topoSetDict) so its neighbours
  become split-face polyhedra. tests/data/mesh/box_refined.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

scale 1;

vertices
(
    (0 0    0)
    (1 0    0)
    (1 0.75 0)
    (0 0.75 0)
    (0 0    0.5)
    (1 0    0.5)
    (1 0.75 0.5)
    (0 0.75 0.5)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (8 6 4) simpleGrading (1 1 1)
);

edges ();

boundary
(
    xlo
    {
        type cyclic;
        neighbourPatch xhi;
        transform translational;
        separationVector (1 0 0);
        faces ((0 4 7 3));
    }
    xhi
    {
        type cyclic;
        neighbourPatch xlo;
        transform translational;
        separationVector (-1 0 0);
        faces ((1 2 6 5));
    }
    ylo
    {
        type cyclic;
        neighbourPatch yhi;
        transform translational;
        separationVector (0 0.75 0);
        faces ((0 1 5 4));
    }
    yhi
    {
        type cyclic;
        neighbourPatch ylo;
        transform translational;
        separationVector (0 -0.75 0);
        faces ((3 7 6 2));
    }
    zlo
    {
        type cyclic;
        neighbourPatch zhi;
        transform translational;
        separationVector (0 0 0.5);
        faces ((0 3 2 1));
    }
    zhi
    {
        type cyclic;
        neighbourPatch zlo;
        transform translational;
        separationVector (0 0 -0.5);
        faces ((4 5 6 7));
    }
);
