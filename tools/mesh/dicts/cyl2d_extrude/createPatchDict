FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

pointSync false;

// The extruded mesh keeps the source patch types; the two z planes become
// the `empty` pair that makes it 2D.
patches
(
    {
        name front;
        patchInfo { type empty; }
        constructFrom patches;
        patches (zhi);
    }
    {
        name back;
        patchInfo { type empty; }
        constructFrom patches;
        patches (zlo);
    }
);
