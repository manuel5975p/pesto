/*--------------------------------*- C++ -*----------------------------------*\
  cyl2d_snappy background: [-4, 8] x [-4, 4], one 0.4 slab in z (30 x 20 x 1).
  snappyHexMesh refines it around a D = 1 cylinder at the origin; extrudeMesh
  then rebuilds a one-cell-thick 2D mesh from the zhi patch.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

scale 1;

vertices
(
    (-4 -4 0)
    ( 8 -4 0)
    ( 8  4 0)
    (-4  4 0)
    (-4 -4 0.4)
    ( 8 -4 0.4)
    ( 8  4 0.4)
    (-4  4 0.4)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (30 20 1) simpleGrading (1 1 1)
);

edges ();

boundary
(
    inlet   { type patch; faces ((0 4 7 3)); }
    outlet  { type patch; faces ((1 2 6 5)); }
    lower   { type patch; faces ((0 1 5 4)); }
    upper   { type patch; faces ((3 7 6 2)); }
    zlo     { type symmetryPlane; faces ((0 3 2 1)); }
    zhi     { type symmetryPlane; faces ((4 5 6 7)); }
);
