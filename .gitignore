# Build tree (CMake + ninja, Release)
build/
build-*/
Testing/

# Large field dumps: regenerable solver output, GB-scale.
# Stats CSVs, .json run metadata and data/validation/ stay tracked.
*.bin
*.gdiag

# Live-viewer frame output written next to the run
web_*/
png_*/

# Frames / renders
*.png

# Run output dropped in the repo root (dns --out NAME, dns-ui --check)
/*.json
/*_stats.csv
/*_profiles.csv
/*_surface.csv

# Local working notes and run trees (untracked by decision)
plans/
runs/
__pycache__/

# Local Python venv (Cantera 3.2.0 for chemistry references)
.venv/

# Large mesh assets
*.glb
*.stl
# 5 KB test fixture (gpu_mrf_rotor2); regenerate with tools/parity/geom.py
!tests/data/rotor2.stl

# Local tool logs (reconfig, viewer server, ...)
*.log
.claude/
