FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
dimensions [0 2 -2 0 0 0 0];
internalField uniform 3.75e-05;
boundaryField
{
    inlet { type fixedValue; value uniform 3.75e-05; }
    outlet { type inletOutlet; inletValue uniform 3.75e-05; value uniform 3.75e-05; }
    top { type zeroGradient; }
    plate { type kqRWallFunction; value uniform 3.75e-05; }
    symmetry { type symmetryPlane; }
    frontAndBack { type empty; }
}
