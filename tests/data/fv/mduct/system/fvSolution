FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
solvers
{
    "pcorr.*"
    {
        solver PCG; preconditioner DIC; tolerance 1e-13; relTol 0; maxIter 5000;
    }
    p
    {
        solver PCG; preconditioner DIC; tolerance 1e-13; relTol 0; maxIter 5000;
    }
    pFinal
    {
        $p;
        relTol          0;
    }
    "(U|k|omega)"
    {
        solver smoothSolver; smoother symGaussSeidel; tolerance 1e-14; relTol 0; maxIter 5000;
    }
    "(U|k|omega)Final"
    {
        $U;
        relTol          0;
    }
}
PIMPLE
{
    correctPhi                  yes;
    nOuterCorrectors            3;
    nCorrectors                 1;
    nNonOrthogonalCorrectors    1;
    turbulenceOnFinalIterOnly   no;
}
relaxationFactors
{
    fields
    {
        p       0.7;
        pFinal  1;
    }
    equations
    {
        "U.*"          0.7;
        "(k|omega).*"  0.7;
    }
}
