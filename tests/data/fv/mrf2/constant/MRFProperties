FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      MRFProperties;
}
rotA
{
    cellZone    rotA;
    active      yes;
    nonRotatingPatches (inlet);
    origin      (0.5 0.5 0.5);
    axis        (1 0 0);
    omega       2;
}
rotB
{
    cellZone    rotB;
    nonRotatingPatches ("fl.*");
    origin      (1.5 0.3 0.6);
    axis        (0 1 1);
    omega       constant -1.5;
}
ghost
{
    active      no;
}
